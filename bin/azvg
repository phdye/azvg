#!/usr/bin/env python
"""Entry point script for azvg command line tool."""

import sys
import os.path

# Add src directory to Python path for development installation
script_dir = os.path.dirname(os.path.abspath(__file__))
src_dir = os.path.join(os.path.dirname(script_dir), 'src')
if os.path.exists(src_dir):
    sys.path.insert(0, src_dir)

# Import and run main function
try:
    from azvg.cli import main
    main()
except ImportError as e:
    print("Error: Failed to import azvg module: {0}".format(str(e)))
    print("Make sure azvg is properly installed.")
    sys.exit(1)
except KeyboardInterrupt:
    print("\nOperation cancelled by user")
    sys.exit(1)
except Exception as e:
    print("Error: {0}".format(str(e)))
    sys.exit(1)
