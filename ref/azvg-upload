#!/usr/bin/env python
# -*- coding: utf-8 -*-

"""
azvg-upload: Upload/merge Azure DevOps variable groups
Usage: azvg-upload <vg-file|vg-name|vg-id> [options]

Options:
    --new               Create a new variable group
    -i, --ignore-case   Case-insensitive name matching

Rules:
- Can specify variable group by file path, name, or ID
- Must not be a new variable group unless --new flag is specified
- Overwrites destination values, except for secure variables
- For secure variables, only overwrites if the new value is not null
"""

import base64
import json
import os
import sys
import argparse

# Import variable group utilities
try:
    from vg_utils import find_vg_file, resolve_vg_identifier
except ImportError:
    # Fallback if vg_utils is not available
    def find_vg_file(identifier, directory='variable-groups'):
        if os.path.isfile(identifier):
            return identifier
        test_path = os.path.join(directory, identifier)
        if os.path.isfile(test_path):
            return test_path
